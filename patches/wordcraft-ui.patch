+// Desktop docked/float rendering lives in `host::show`; it's renamed here so the mobile-aware
+// `show` (below) can dispatch on screen width.
+pub(crate) use host::show as show_desktop;
+
+/// Which panes are open, from the session's view state.
+fn pane_open(app: &WordApp, pane: Pane) -> bool {
+    match pane {
+        Pane::SmartArtText => app.session.view.smart_art_text_pane,
+        Pane::Navigation => app.session.view.navigation_pane,
+        Pane::Clipboard => app.session.view.clipboard_pane,
+        Pane::Styles => app.session.view.styles_pane,
+        Pane::StyleInspector => app.session.view.style_inspector_pane,
+        Pane::Accessibility => app.session.view.accessibility_pane,
+        Pane::AltText => app.session.view.alt_text_pane,
+        Pane::FormatShape => app.session.view.format_shape_pane,
+        Pane::RestrictEditing => app.session.view.restrict_editing_pane,
+        Pane::Proofing => app.session.view.proofing_pane,
+        Pane::Comments => app.session.view.comments_pane,
+    }
+}
+
+/// Draws the panes: docked/floating on desktop, a single bottom sheet on mobile (one pane at a time).
+pub fn show(app: &mut WordApp, ui: &mut Ui) {
+    let is_mobile = ui.ctx().screen_rect().width() < 600.0;
+    if is_mobile {
+        show_mobile(app, ui);
+    } else {
+        show_desktop(app, ui);
+    }
+}
+
+/// Mobile: the first open pane is drawn as a bottom sheet over the document.
+fn show_mobile(app: &mut WordApp, ui: &mut Ui) {
+    let open_pane = Pane::ALL.iter().copied().find(|p| pane_open(app, *p));
+    if let Some(pane) = open_pane {
+        render_sheet(app, ui, pane);
+    }
+}
+
+fn render_sheet(app: &mut WordApp, ui: &mut Ui, pane: Pane) {
+    let ctx = ui.ctx().clone();
+    let screen = ctx.screen_rect();
+    let sheet_h = (screen.height() * 0.55).max(220.0);
+    let mut close = false;
+
+    // Dim overlay behind the sheet; a tap closes it.
+    egui::Area::new(egui::Id::new("mobile_pane_overlay"))
+        .fixed_pos(screen.min)
+        .order(egui::Order::Middle)
+        .show(&ctx, |ui| {
+            ui.painter().rect_filled(screen, 0.0, egui::Color32::from_black_alpha(140));
+            let resp = ui.allocate_rect(screen, Sense::click());
+            if resp.clicked() {
+                close = true;
+            }
+        });
+
+    // Sheet.
+    egui::Area::new(egui::Id::new("mobile_pane_sheet"))
+        .fixed_pos(egui::pos2(screen.min.x, screen.max.y - sheet_h))
+        .order(egui::Order::Foreground)
+        .show(&ctx, |ui| {
+            let t = Tokens::get(&ctx);
+            ui.set_width(screen.width());
+            ui.set_height(sheet_h);
+            egui::Frame::NONE
+                .fill(t.ribbon)
+                .inner_margin(egui::Margin::same(0))
+                .show(ui, |ui| {
+                    // Drag handle.
+                    let (handle_rect, _) = ui.allocate_exact_size(vec2(ui.available_width(), 20.0), Sense::hover());
+                    ui.painter().rect_filled(
+                        egui::Rect::from_center_size(handle_rect.center(), vec2(40.0, 4.0)),
+                        2.0,
+                        t.text_dim,
+                    );
+                    // Header.
+                    ui.horizontal(|ui| {
+                        ui.add_space(16.0);
+                        ui.label(egui::RichText::new(tl!(pane.title())).font(semibold(20.0)));
+                        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                            ui.add_space(12.0);
+                            let (r, resp) = ui.allocate_exact_size(vec2(40.0, 40.0), Sense::click());
+                            if resp.hovered() {
+                                ui.painter().rect_filled(r, 4.0, t.hover);
+                            }
+                            ui.painter().text(
+                                r.center(),
+                                egui::Align2::CENTER_CENTER,
+                                "✕",
+                                regular(18.0),
+                                t.text,
+                            );
+                            if resp.clicked() {
+                                close = true;
+                            }
+                        });
+                    });
+                    ui.add_space(4.0);
+                    ui.separator();
+                    // Body.
+                    egui::ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| {
+                        let mut content = Content { app };
+                        ui.add_space(8.0);
+                        content.body(ui, &pane);
+                    });
+                });
+        });
+
+    if close {
+        if let Some(cmd) = pane.close_command() {
+            let _ = app.run(cmd, json!({"value": false}));
+        } else if matches!(pane, Pane::RestrictEditing) {
+            let _ = app.run("view.restrictEditingPane", json!({"value": false}));
+        } else if matches!(pane, Pane::Proofing) {
+            let _ = app.run("view.proofingPane", json!({"value": false}));
+        }
+    }
+}
